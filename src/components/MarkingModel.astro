---
interface MarkingBand {
  tier: string;
  descriptor: string;
}

interface WeightedMarking {
  mode: "weighted";
  criteria: { name: string; weight: number; bands?: MarkingBand[] }[];
}

interface HolisticMarking {
  mode: "holistic";
  description: string;
  bands?: MarkingBand[];
}

interface Props {
  marking: WeightedMarking | HolisticMarking;
}

const { marking } = Astro.props;
---

<section aria-labelledby="how-marked">
  <h2 id="how-marked">How it is marked</h2>
  {marking.mode === "holistic" ? (
    <p>{marking.description}</p>
  ) : (
    <table>
      <thead><tr><th scope="col">Criterion</th><th scope="col">Weight</th></tr></thead>
      <tbody>
        {marking.criteria.map((criterion) => (
          <tr><td>{criterion.name}</td><td>{criterion.weight}%</td></tr>
        ))}
      </tbody>
    </table>
  )}
  {marking.mode === "holistic" && marking.bands && (
    <table class="marking-bands">
      <caption>What each tier looks like</caption>
      <thead><tr><th scope="col">Tier</th><th scope="col">Descriptor</th></tr></thead>
      <tbody>
        {marking.bands.map((band) => (
          <tr><td>{band.tier}</td><td>{band.descriptor}</td></tr>
        ))}
      </tbody>
    </table>
  )}
  {marking.mode === "weighted" &&
    marking.criteria.map(
      (criterion) =>
        criterion.bands && (
          <table class="marking-bands">
            <caption>{criterion.name} — what each tier looks like</caption>
            <thead><tr><th scope="col">Tier</th><th scope="col">Descriptor</th></tr></thead>
            <tbody>
              {criterion.bands.map((band) => (
                <tr><td>{band.tier}</td><td>{band.descriptor}</td></tr>
              ))}
            </tbody>
          </table>
        ),
    )}
</section>

<style>
  .marking-bands {
    margin-block-start: 1rem;
  }

  .marking-bands caption {
    margin-block-end: 0.4rem;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
    text-align: left;
  }
</style>
