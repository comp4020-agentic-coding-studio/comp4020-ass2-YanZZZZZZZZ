---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const lectures = await getPublishedCollection("lectures");
const sessions = await getPublishedCollection("sessions");

type WeekEntry =
  | { entry: (typeof lectures)[number]; kind: "lectures" }
  | { entry: (typeof sessions)[number]; kind: "sessions" };

// Every week is a beat in one story, not a schedule line — the lecture
// collection is the story's own voice ("Write the bad ending first", not
// "Week 11: assessment overview"), with the week-6 session filling the one
// week that deliberately has no lecture (a "no new subsystem" beat, not a
// gap).
const byWeek = new Map<number, WeekEntry>(
  lectures.map((lecture) => [lecture.data.week, { entry: lecture, kind: "lectures" }]),
);
for (const session of sessions) {
  if (!byWeek.has(session.data.week)) {
    byWeek.set(session.data.week, { entry: session, kind: "sessions" });
  }
}

const beats = [...byWeek.entries()]
  .sort(([a], [b]) => a - b)
  .map(([week, { entry, kind }]) => ({
    week,
    title: entry.data.title,
    description: entry.data.description,
    href: withBase(`/${kind}/${entry.id}/`),
  }));
---

<div class="timeline-track">
  <ol class="timeline">
    {
      beats.map((beat) => (
        <li class="timeline-item">
          <span class="timeline-week" aria-hidden="true">
            {beat.week}
          </span>
          <h3>
            <a href={beat.href}>{beat.title}</a>
          </h3>
          {beat.description && <p>{beat.description}</p>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* Line and node colour both derive from --at-primary via color-mix, the
     same approach PageLayout.astro uses for .at-card, so this skin can't
     drift from the brand token. */
  .timeline-track {
    overflow-x: auto;
    padding-block-end: 0.5rem;
  }

  .timeline {
    position: relative;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding-block-start: 1.2rem;
    padding-inline: 0;
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    inset-inline: 1.1rem;
    top: calc(1.2rem + 1.1rem);
    height: 2px;
    background: color-mix(in oklch, var(--at-primary) 40%, transparent);
  }

  .timeline-item {
    position: relative;
    flex: 0 0 15rem;
  }

  .timeline-week {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    margin-block-end: 0.75rem;
    place-items: center;
    border-radius: 50%;
    background: var(--at-primary);
    color: var(--at-bg);
    font-family: "Cinzel", var(--at-font-body);
    font-weight: 700;
  }

  .timeline-item h3 {
    margin-block: 0 0.25rem;
    font-size: 1rem;
  }

  .timeline-item p {
    display: -webkit-box;
    margin-block: 0;
    overflow: hidden;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }
</style>
