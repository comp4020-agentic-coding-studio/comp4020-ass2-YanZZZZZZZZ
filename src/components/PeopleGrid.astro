---
import { Image } from "astro:assets";
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";

const people = await getPublishedCollection("people");

const roleOrder: Record<string, number> = {
  convenor: 0,
  lecturer: 1,
  tutor: 2,
  guest: 3,
  other: 4,
};

// Map the role enum (convenor|lecturer|tutor|guest|other) to display labels
// rather than rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  lecturer: "Lecturer",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};

// photoAlt rides the schema's passthrough (definePeopleCollection has no
// extension point), so it needs a cast out of the generated types.
function photoAlt(data: unknown): string | undefined {
  const alt = (data as { photoAlt?: unknown }).photoAlt;
  return typeof alt === "string" ? alt : undefined;
}

const visible = people.sort((a, b) => {
  const ra = roleOrder[a.data.role ?? "other"] ?? 99;
  const rb = roleOrder[b.data.role ?? "other"] ?? 99;
  if (ra !== rb) return ra - rb;
  return a.data.title.localeCompare(b.data.title);
});
---

<CardGrid columns={2}>
  {
    visible.map((person) => (
      <div class="person-card">
        <Card
          headingLevel="h2"
          title={person.data.title}
          href={`/people/${person.id}/`}
          image={person.data.photo ?? undefined}
          imageAlt={photoAlt(person.data)}
        >
          {person.data.role && roleLabels[person.data.role] && (
            <p>
              <small>{roleLabels[person.data.role]}</small>
            </p>
          )}
          <p>{person.data.description}</p>
        </Card>
        {person.data.gamerAvatar && (
          <Image
            class="person-card-avatar"
            src={person.data.gamerAvatar}
            alt=""
            width={56}
            height={56}
          />
        )}
      </div>
    ))
  }
</CardGrid>

<style>
  /* A player-badge stamped over the formal portrait's corner, not a
     replacement for it — the gamer avatar identifies the postcard below
     without displacing the photo Card.astro already renders. */
  .person-card {
    position: relative;
  }

  .person-card-avatar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 2px solid var(--at-bg);
    background: var(--at-bg-alt);
    box-shadow: 0 1px 4px color-mix(in oklch, black 35%, transparent);
    pointer-events: none;
  }
</style>
